# Copy this file to .env.local and fill in the values you need.
# Public GitHub repos can be ingested without a token; a token raises API rate limits.
GITHUB_TOKEN=

# Neo4j AuraDB (optional). When blank, real repository data stays in process memory only.
NEO4J_URI=neo4j+s://<your-aura-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-password>

# Bounded ingestion limits (maximums are enforced server-side)
MAX_COMMITS=20
MAX_PULL_REQUESTS=15
MAX_ISSUES=15

# Server
PORT=3000
HOST=127.0.0.1

# Optional AI summarizer: if absent, the deterministic evidence-grounded answer engine is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
